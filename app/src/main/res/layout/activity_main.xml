<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9F4"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="🌱 Gestión de Residuos ECOLIM"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/etCodigo"
            android:hint="Código (para buscar, modificar o eliminar)"
            android:inputType="number"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/spTipoResiduo"
            android:entries="@array/tipos_residuos"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPeso"
            android:hint="Peso en Kg"
            android:inputType="numberDecimal"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etFecha"
            android:hint="Fecha (ej. 2026-06-06)"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnRegistrar"
            android:text="✨ Registrar Residuo"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnBuscar"
            android:text="🔍 Buscar por Código"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0277BD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnModificar"
            android:text="✏️ Modificar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F57F17"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnEliminar"
            android:text="🗑️ Eliminar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#C62828"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:text="📋 Historial de Transacciones:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#37474F"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvReporte"
            android:text="Cargando registros..."
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"/>

    </LinearLayout>
</ScrollView>